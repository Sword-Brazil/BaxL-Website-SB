# --- Banco: Postgres do Supabase (Project Settings → Database → Connect) ---
# Use o pooler (IPv4): a conexão direta db.<ref>.supabase.co é só IPv6 (não funciona no WSL nem na Vercel).
# A senha pode ficar numa variável e entrar nas URLs com ${...} (só letras e números, ou codifique-a).
SUPABASE_DB_PASSWORD=""
# App e funções serverless: "Transaction pooler" (porta 6543), com pgbouncer=true e connection_limit=1.
DATABASE_URL="postgresql://postgres.<ref>:${SUPABASE_DB_PASSWORD}@aws-0-<região>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrações (npm run db:deploy): "Session pooler" (porta 5432).
DIRECT_URL="postgresql://postgres.<ref>:${SUPABASE_DB_PASSWORD}@aws-0-<região>.pooler.supabase.com:5432/postgres"

# --- Imagens enviadas pela curadoria: Supabase Storage (Project Settings → API) ---
# Sem estas variáveis (só no ambiente local), os uploads vão para public/assets/uploads.
SUPABASE_URL="https://<ref>.supabase.co"
# Chave secreta (service_role / secret key): só no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket público das imagens (criado pelo `npm run db:migrate-data` se não existir).
SUPABASE_STORAGE_BUCKET="assets"

# Segredo da sessão (iron-session). Mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Administrador padrão criado pelo seed (npm run db:seed). Ele cria as demais contas.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Opcional: nome de usuário para o administrador também entrar sem o e-mail.
SEED_ADMIN_USERNAME=""

# URL pública do site (links nos e-mails de aviso)
APP_URL="http://localhost:3000"
