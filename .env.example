# Banco SQLite local (relativo a prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Segredo da sessão (iron-session). Mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Contas criadas pelo seed (npx prisma db seed)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# URL base usada nos links de confirmação de e-mail e redefinição de senha
APP_URL="http://localhost:3000"
