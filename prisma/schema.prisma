// Modelo de dados: specs/001-alliance-battle-metas/data-model.md
// "Enums" são String validadas por Zod (src/models/schemas).

generator client {
  provider = "prisma-client-js"
}

// Postgres do Supabase: DATABASE_URL é o pooler (app/serverless) e DIRECT_URL a conexão
// direta, usada pelo `prisma migrate`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Catálogo ----------

model Agent {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  active     Boolean    @default(true)
  uniforms   Uniform[]
  // CTPs da Meta para o personagem: o 1 (padrão) e o 2 (opcional), alternados por dia nas equipes.
  metaCtp1Id String?
  metaCtp1   Ctp?       @relation("AgentMetaCtp1", fields: [metaCtp1Id], references: [id], onDelete: SetNull)
  metaCtp2Id String?
  metaCtp2   Ctp?       @relation("AgentMetaCtp2", fields: [metaCtp2Id], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  rotations  Rotation[]
}

model Uniform {
  id              String           @id @default(cuid())
  agentId         String
  agent           Agent            @relation(fields: [agentId], references: [id])
  slug            String
  name            String
  imagePath       String
  // Atributos são do traje (ex.: Fênix Negra é vilã), não do personagem. UNKNOWN = não informado.
  gender          String           @default("UNKNOWN")
  side            String           @default("UNKNOWN")
  species         String           @default("UNKNOWN")
  attackType      String           @default("UNKNOWN")
  // Efeitos que o traje causa no chefe da BA (SILENCE, PARALYSIS, BURN, FRACTURE, SHOCK, TRAP).
  effects         String[]         @default([])
  // Striker meta: só os trajes marcados aparecem no seletor de Striker dos Causadores de Dano.
  isMetaStriker   Boolean          @default(false)
  active          Boolean          @default(true)
  metaMembers     MetaTeamMember[] @relation("MemberUniform")
  priorityEntries PriorityEntry[]
  rotations       Rotation[]       @relation("RotationUniform")
  strikerOf       MetaTeamMember[] @relation("MemberStriker")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([agentId, slug])
}

model Ctp {
  id              String           @id @default(cuid())
  type            String
  quality         String
  imagePath       String
  active          Boolean          @default(true)
  metaMembers     MetaTeamMember[]
  priorityEntries PriorityEntry[]
  metaCtp1Of      Agent[]          @relation("AgentMetaCtp1")
  metaCtp2Of      Agent[]          @relation("AgentMetaCtp2")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([type, quality])
}

// ---------- Calendário e restrições ----------

model Settings {
  id              Int      @id @default(1)
  cycleAnchor     DateTime
  dayTurnoverHour Int      @default(12)
  weeklyResetHour Int      @default(22)
  baiWeekday      Int      @default(3)
  // Temporada atual: efeito que atordoa o chefe em todos os dias de BAX e de BAL.
  baxEffect       String   @default("PARALYSIS")
  balEffect       String   @default("SHOCK")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BattleDay {
  id              String                 @id @default(cuid())
  mode            String
  number          Int
  criteria        RestrictionCriterion[]
  metaTeams       MetaTeam[]
  priorityEntries PriorityEntry[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([mode, number])
}

model RestrictionCriterion {
  id          String    @id @default(cuid())
  battleDayId String
  battleDay   BattleDay @relation(fields: [battleDayId], references: [id], onDelete: Cascade)
  attribute   String
  value       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([battleDayId, attribute])
}

// ---------- Equipes curadas ----------

model MetaTeam {
  id          String           @id @default(cuid())
  scope       String
  battleDayId String?
  battleDay   BattleDay?       @relation(fields: [battleDayId], references: [id])
  isPrimary   Boolean          @default(false)
  // Ordem das alternativas no dia (o ADMIN reordena); a principal vem sempre primeiro.
  position    Int              @default(0)
  label       String?
  notes       String?
  members     MetaTeamMember[]
  updatedById String?
  updatedBy   User?            @relation(fields: [updatedById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([scope, battleDayId])
}

model MetaTeamMember {
  id               String   @id @default(cuid())
  metaTeamId       String
  metaTeam         MetaTeam @relation(fields: [metaTeamId], references: [id], onDelete: Cascade)
  slot             String
  uniformId        String
  uniform          Uniform  @relation("MemberUniform", fields: [uniformId], references: [id])
  // CTP do membro, já resolvido pelo slot (Agent.metaCtp1/2); slot null = equipe antiga, CTP só dela.
  ctpId            String?
  ctp              Ctp?     @relation(fields: [ctpId], references: [id])
  ctpSlot          Int?
  // Causador de Dano (qualquer posição): as rotações dele ficam em Rotation (por personagem/traje).
  isDamageDealer   Boolean  @default(false)
  // Striker meta (apoio da Transcendência 4) do Causador de Dano nesta equipe.
  strikerUniformId String?
  striker          Uniform? @relation("MemberStriker", fields: [strikerUniformId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([metaTeamId, slot])
}

// Rotação de um personagem (Causador de Dano), em texto livre, com descrição e vídeo opcional.
// uniformId null = vale para todos os trajes do personagem.
model Rotation {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  uniformId   String?
  uniform     Uniform? @relation("RotationUniform", fields: [uniformId], references: [id], onDelete: Cascade)
  // Temporada (efeito do chefe) da rotação; null = vale para todas.
  effect      String?
  position    Int
  title       String?
  sequence    String
  description String?
  // Link do YouTube ou de um .mp4/.webm externo: o sistema não hospeda vídeo.
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId, position])
}

model PriorityEntry {
  id          String     @id @default(cuid())
  scope       String
  battleDayId String?
  battleDay   BattleDay? @relation(fields: [battleDayId], references: [id])
  role        String
  rank        Int
  uniformId   String
  uniform     Uniform    @relation(fields: [uniformId], references: [id])
  ctpId       String?
  ctp         Ctp?       @relation(fields: [ctpId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // battleDayId nulo (BAI) não é coberto pela unicidade no SQLite: o priorityService garante.
  @@unique([scope, battleDayId, role, rank])
}

model BaiBoss {
  id        String   @id @default(cuid())
  position  Int      @unique
  name      String
  imagePath String?
  tips      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Curadoria (login só de curadores e administradores) ----------
// Jogadores não têm conta: elenco, equipes e nome no jogo ficam no aparelho (localStorage).

// Todo login é nome de usuário + senha (sem e-mail). Só administradores criam contas e trocam
// senhas (não há cadastro nem "esqueci a senha").
model User {
  id           String             @id @default(cuid())
  // Guardado em minúsculas, com espaços simples (ex.: "sword menezes").
  username     String             @unique
  // Chaves de identidade (src/models/rules/userIdentity.ts): bloqueiam a mesma pessoa em duas
  // contas, com o nome escrito de outro jeito. Preenchidas pelo usersService.
  usernameKey  String?            @unique
  passwordHash String
  nickname     String?
  nicknameKey  String?            @unique
  role         String             @default("USER")
  selections   UserSelectionsDoc?
  metaTeams    MetaTeam[]
  notices      SecurityNotice[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// Elenco, equipes, CTPs e nome no jogo do jogador logado (documento JSON), iguais em todo aparelho.
model UserSelectionsDoc {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  json      String
  updatedAt DateTime @updatedAt
}

model LoginAttempt {
  key         String    @id
  failedCount Int       @default(0)
  firstFailAt DateTime?
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Aviso persistente de segurança (atenção/crítico): some quando o usuário dispensa ou resolve.
// Um aviso aberto por tipo e usuário: eventos repetidos atualizam o mesmo aviso.
model SecurityNotice {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  // JSON com parâmetros não sensíveis (ex.: {"role":"ADMIN"}).
  params          String?
  // Sessão que causou o evento: o aviso de "novo login" não aparece nela mesma.
  originSessionId String?
  dismissedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, dismissedAt])
}
